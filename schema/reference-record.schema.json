{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/keepraw/airport-history/schema/reference-record/1.0.0",
  "title": "Reference source record, not verified physical-airport identity",
  "type": "object",
  "additionalProperties": false,
  "required": ["referenceId", "sourceId", "sourceEntityId", "identityStatus", "historicallyVerified", "presentAtSnapshot", "name", "facilityType", "country", "region", "municipality", "identifiers", "timezone", "timezoneEvidence", "locations", "curatedAirportIds", "observedAt", "observation", "historicalIdentifiers", "historicalNames", "flags"],
  "properties": {
    "referenceId": {"type": "string", "pattern": "^ref_[a-f0-9]{24}$"},
    "sourceId": {"const": "ourairports"},
    "sourceEntityId": {"type": "string", "pattern": "^[0-9]+$"},
    "identityStatus": {"const": "external_record_only"},
    "historicallyVerified": {"const": false},
    "presentAtSnapshot": {"type": "boolean"},
    "name": {"type": ["string", "null"]},
    "facilityType": {"enum": ["balloonport", "closed", "heliport", "large_airport", "medium_airport", "seaplane_base", "small_airport"]},
    "country": {"type": ["string", "null"]},
    "region": {"type": ["string", "null"]},
    "municipality": {"type": ["string", "null"]},
    "identifiers": {
      "type": "object", "additionalProperties": false,
      "required": ["IATA", "ICAO", "GPS", "LOCAL", "IDENT"],
      "properties": {
        "IATA": {"type": ["string", "null"]}, "ICAO": {"type": ["string", "null"]},
        "GPS": {"type": ["string", "null"]}, "LOCAL": {"type": ["string", "null"]}, "IDENT": {"type": ["string", "null"]}
      }
    },
    "timezone": {"type": ["string", "null"]},
    "timezoneEvidence": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["sourceId", "sourceEntityId", "revision", "timezone"],
        "properties": {
          "sourceId": {"const": "airportsdata"}, "sourceEntityId": {"type": "string"},
          "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "timezone": {"type": "string"}
        }
      }
    },
    "locations": {
      "type": "array", "minItems": 1, "items": {
        "type": "object", "additionalProperties": false,
        "required": ["locationId", "coordinates", "kind", "curatedAirportIds", "candidateIds"],
        "properties": {
          "locationId": {"type": "string", "pattern": "^loc_[a-f0-9]{24}$"},
          "coordinates": {"anyOf": [{"type": "null"}, {"$ref": "#/definitions/coordinates"}]},
          "kind": {"enum": ["snapshot", "last_known_row", "unresolved_transition_location"]},
          "curatedAirportIds": {"$ref": "#/definitions/airportIds"},
          "candidateIds": {"$ref": "#/definitions/candidateIds"}
        }
      }
    },
    "curatedAirportIds": {"$ref": "#/definitions/airportIds"},
    "observedAt": {"type": ["string", "null"]},
    "observation": {
      "type": "object", "additionalProperties": false, "required": ["kind", "revision", "blob"],
      "properties": {
        "kind": {"enum": ["snapshot", "pre_removal_blob", "retained_inventory_row"]},
        "revision": {"type": ["string", "null"], "pattern": "^[a-f0-9]{40}$"},
        "blob": {"type": ["string", "null"], "pattern": "^[a-f0-9]{40}$"},
        "inventory": {"type": "string"}, "lastChangedAt": {"type": "string"},
        "removalCandidateId": {"type": "string", "pattern": "^cand_[a-f0-9]{24}$"}
      }
    },
    "historicalIdentifiers": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["sourceId", "scheme", "code", "candidateId", "side", "commit", "blob", "revisionObservedAt", "meaning"],
        "properties": {
          "sourceId": {"enum": ["ourairports", "airport-codes-raw"]},
          "scheme": {"enum": ["IATA", "ICAO"]}, "code": {"type": "string"},
          "candidateId": {"type": "string", "pattern": "^cand_[a-f0-9]{24}$"},
          "side": {"enum": ["before", "after"]},
          "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "blob": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
          "revisionObservedAt": {"type": "string"}, "meaning": {"type": "string"}
        }
      }
    },
    "historicalNames": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["sourceId", "name", "candidateId", "side", "revisionObservedAt"],
        "properties": {
          "sourceId": {"enum": ["ourairports", "airport-codes-raw"]},
          "name": {"type": "string"}, "candidateId": {"type": "string", "pattern": "^cand_[a-f0-9]{24}$"},
          "side": {"enum": ["before", "after"]}, "revisionObservedAt": {"type": "string"}
        }
      }
    },
    "flags": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
  },
  "definitions": {
    "airportIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^apt_[a-f0-9-]{36}$"}},
    "candidateIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^cand_[a-f0-9]{24}$"}},
    "coordinates": {
      "type": "object", "additionalProperties": false, "required": ["latitude", "longitude"],
      "properties": {"latitude": {"type": "number", "minimum": -90, "maximum": 90}, "longitude": {"type": "number", "minimum": -180, "maximum": 180}}
    }
  }
}
