{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/keepraw/airport-history/schema/dataset.schema.json",
  "title": "Airport history dataset",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "2.0.0"
    },
    "dataVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "airports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/airport"
      }
    },
    "assignments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/assignment"
      }
    }
  },
  "required": [
    "schemaVersion",
    "dataVersion",
    "sources",
    "airports",
    "assignments"
  ],
  "$defs": {
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^(?!0000)\\d{4}-\\d{2}-\\d{2}$"
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "earliest": {
          "anyOf": [
            {
              "$ref": "#/$defs/date"
            },
            {
              "type": "null"
            }
          ]
        },
        "latest": {
          "anyOf": [
            {
              "$ref": "#/$defs/date"
            },
            {
              "type": "null"
            }
          ]
        },
        "precision": {
          "enum": ["exact", "day", "month", "year", "unknown"]
        }
      },
      "required": ["earliest", "latest", "precision"]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "accessedOn": {
          "$ref": "#/$defs/date"
        },
        "verificationStatus": {
          "enum": ["verified", "pending", "disputed"]
        },
        "sourceType": {
          "description": "Nature of the publication for its own subject; primary does not imply direct code-allocation evidence.",
          "enum": ["primary", "secondary"]
        },
        "license": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https?://"
                },
                {
                  "type": "null"
                }
              ]
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["id", "url", "note"]
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "sourceId",
        "title",
        "url",
        "accessedOn",
        "verificationStatus",
        "sourceType",
        "license",
        "note"
      ]
    },
    "airport": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "airportId": {
          "type": "string",
          "pattern": "^apt_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "name": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "value": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "status": {
              "enum": ["verified", "reference", "unknown"]
            },
            "sourceIds": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["value", "status", "sourceIds", "note"]
        },
        "coordinates": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "value": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "latitude": {
                      "type": "number",
                      "minimum": -90,
                      "maximum": 90
                    },
                    "longitude": {
                      "type": "number",
                      "minimum": -180,
                      "maximum": 180
                    }
                  },
                  "required": ["latitude", "longitude"]
                },
                {
                  "type": "null"
                }
              ]
            },
            "status": {
              "enum": ["verified", "reference", "unknown"]
            },
            "sourceIds": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["value", "status", "sourceIds", "note"]
        },
        "timezone": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "value": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?:[A-Za-z_]+(?:/[A-Za-z0-9_+\\-]+)+|UTC)$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "status": {
              "enum": ["verified", "reference", "unknown"]
            },
            "sourceIds": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["value", "status", "sourceIds", "note"]
        },
        "externalIds": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ourAirports": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          },
          "required": []
        }
      },
      "required": [
        "airportId",
        "name",
        "coordinates",
        "timezone",
        "externalIds"
      ]
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assignmentId": {
          "type": "string",
          "minLength": 1
        },
        "scheme": {
          "enum": ["IATA", "ICAO"]
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Z]{3,4}$"
        },
        "airportId": {
          "type": "string",
          "minLength": 1
        },
        "validFrom": {
          "$ref": "#/$defs/boundary"
        },
        "validTo": {
          "$ref": "#/$defs/boundary"
        },
        "verificationStatus": {
          "enum": ["verified", "pending", "disputed"]
        },
        "verifiedOn": {
          "anyOf": [
            {
              "$ref": "#/$defs/date"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidenceType": {
          "description": "Basis for the whole continuous code assignment: explicit first-hand code record, indirect corroboration, or continuity inferred between observations. Independent of review status and boundary precision.",
          "enum": ["primary_direct", "indirect", "continuity_inference"]
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "assignmentId",
        "scheme",
        "code",
        "airportId",
        "validFrom",
        "validTo",
        "verificationStatus",
        "verifiedOn",
        "evidenceType",
        "sourceIds",
        "note"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "scheme": {
                "const": "IATA"
              }
            }
          },
          "then": {
            "properties": {
              "code": {
                "pattern": "^[A-Z]{3}$",
                "type": "string"
              }
            }
          },
          "else": {
            "properties": {
              "code": {
                "pattern": "^[A-Z]{4}$",
                "type": "string"
              }
            }
          }
        }
      ]
    }
  }
}
