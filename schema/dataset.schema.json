{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/keepraw/airport-history/schema/4.0.0/dataset.schema.json",
  "title": "Airport history dataset",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "4.0.0"
    },
    "dataVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "airports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/airport"
      }
    },
    "names": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/airportName"
      }
    },
    "assignments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/assignment"
      }
    }
  },
  "required": [
    "schemaVersion",
    "dataVersion",
    "airports",
    "assignments",
    "names"
  ],
  "$defs": {
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^(?!0000)\\d{4}-\\d{2}-\\d{2}$"
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "earliest": {
          "anyOf": [
            {
              "$ref": "#/$defs/date"
            },
            {
              "type": "null"
            }
          ]
        },
        "latest": {
          "anyOf": [
            {
              "$ref": "#/$defs/date"
            },
            {
              "type": "null"
            }
          ]
        },
        "precision": {
          "enum": ["exact", "day", "month", "year", "unknown"]
        }
      },
      "required": ["earliest", "latest", "precision"]
    },
    "airport": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "airportId": {
          "type": "string",
          "pattern": "^apt_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "name": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "value": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "status": {
              "enum": ["verified", "reference", "unknown"]
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["value", "status", "note"]
        },
        "coordinates": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "value": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "latitude": {
                      "type": "number",
                      "minimum": -90,
                      "maximum": 90
                    },
                    "longitude": {
                      "type": "number",
                      "minimum": -180,
                      "maximum": 180
                    }
                  },
                  "required": ["latitude", "longitude"]
                },
                {
                  "type": "null"
                }
              ]
            },
            "status": {
              "enum": ["verified", "reference", "unknown"]
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["value", "status", "note"]
        },
        "timezone": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "value": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?:[A-Za-z_]+(?:/[A-Za-z0-9_+\\-]+)+|UTC)$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "status": {
              "enum": ["verified", "reference", "unknown"]
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["value", "status", "note"]
        },
        "externalIds": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ourAirports": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          },
          "required": []
        }
      },
      "required": [
        "airportId",
        "name",
        "coordinates",
        "timezone",
        "externalIds"
      ]
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assignmentId": {
          "type": "string",
          "minLength": 1
        },
        "scheme": {
          "enum": ["IATA", "ICAO"]
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Z]{3,4}$"
        },
        "airportId": {
          "type": "string",
          "minLength": 1
        },
        "validFrom": {
          "$ref": "#/$defs/boundary"
        },
        "validTo": {
          "$ref": "#/$defs/boundary"
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "assignmentId",
        "scheme",
        "code",
        "airportId",
        "validFrom",
        "validTo",
        "note"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "scheme": {
                "const": "IATA"
              }
            }
          },
          "then": {
            "properties": {
              "code": {
                "pattern": "^[A-Z]{3}$",
                "type": "string"
              }
            }
          },
          "else": {
            "properties": {
              "code": {
                "pattern": "^[A-Z]{4}$",
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "airportName": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nameId": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "language": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
        },
        "kind": {
          "description": "Only canonical official names participate in date resolution. Aliases and translations never imply an official rename; city names are excluded.",
          "enum": ["official", "alias", "translation"]
        },
        "airportId": {
          "type": "string",
          "minLength": 1
        },
        "validFrom": {
          "$ref": "#/$defs/boundary"
        },
        "validTo": {
          "$ref": "#/$defs/boundary"
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "nameId",
        "airportId",
        "name",
        "language",
        "kind",
        "validFrom",
        "validTo",
        "note"
      ]
    }
  }
}
