{
  "name": "@keepraw/airport-history",
  "version": "0.7.0",
  "private": true,
  "description": "Historical airport identities, locations, code assignments, and official names.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^24.0.0"
  },
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "validate:data": "node scripts/validate.ts",
    "test": "vitest run",
    "build": "node scripts/build.ts",
    "check": "pnpm typecheck && pnpm validate:data && pnpm test && pnpm test:research && pnpm research:validate && pnpm reference:validate && pnpm test:reference && pnpm build",
    "research:fetch": "python3 scripts/discovery/fetch.py",
    "research:scan": "python3 scripts/discovery/scan.py",
    "research:report": "python3 scripts/discovery/report.py",
    "research:review-report": "python3 scripts/discovery/refresh_reviews.py",
    "research:validate": "python3 scripts/discovery/validate.py",
    "test:research": "python3 -m unittest discover -s test/discovery -v",
    "reference:fetch": "python3 scripts/reference/fetch.py",
    "reference:build": "python3 scripts/reference/build.py && python3 scripts/reference/triage.py",
    "reference:lookup": "python3 scripts/reference/query.py",
    "reference:review": "python3 scripts/reference/admissions.py",
    "reference:validate": "node scripts/reference/validate-schema.ts && python3 scripts/reference/validate.py",
    "test:reference": "python3 -m unittest discover -s test/reference -v"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "typescript": "^5.9.2",
    "vitest": "^4.0.0"
  }
}
